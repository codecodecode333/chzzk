# Copy to .env (git-ignored). Read by docker compose and by the backend (bootRun from backend/).

# This PC's LAN IP, advertised by MediaMTX for WebRTC media (see README).
LAN_IP=192.168.0.23

# Shared secret MediaMTX sends to the backend's auth callback. Required for 라이브: while it is empty the backend refuses
# every publish and watch. Use a long random value of letters and digits, e.g. from
#   PowerShell: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
#   or: openssl rand -hex 32
MEDIAMTX_AUTH_SECRET=
