{
  "name": "chzzk-desktop",
  "productName": "Chzzk",
  "description": "치지직 데스크톱 앱: 방송 목록과 방송 시청",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build:renderer": "tsc -b && vite build",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg --universal --publish never",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "happy-dom": "21.0.4",
    "msw": "3.0.5",
    "oxlint": "1.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "dev.codecodecode333.chzzk.desktop",
    "productName": "Chzzk",
    "copyright": "치지직",
    "directories": { "output": "release" },
    "files": ["electron/**", "dist/**", "package.json"],
    "npmRebuild": false,
    "publish": null,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "artifactName": "chzzk-desktop-setup-x64.${ext}", "shortcutName": "치지직" },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "dmg": { "artifactName": "chzzk-desktop-mac-universal.${ext}" }
  }
}
