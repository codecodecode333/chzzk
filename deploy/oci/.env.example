# Copy to deploy/oci/.env (git-ignored) and fill in. Never commit OCIDs.
# Compartment to create everything in; the tenancy OCID (from ~/.oci/config) means the root compartment.
OCI_COMPARTMENT_ID=
# CIDR allowed to SSH (22/tcp). Empty: this PC's current public IP /32.
SSH_ALLOW_CIDR=
# Public key put on the VM.
SSH_PUBKEY=~/.ssh/chzzk_oci.pub
# Space-separated availability domain names to try, in order. Empty: every AD in the region.
OCI_ADS=
# Path to the oci executable if it is not on PATH (e.g. ~/.oci-cli-venv/Scripts/oci).
OCI_BIN=oci
# After the A1 2/12 and 1/6 passes fail on capacity, keep retrying for this many minutes (0 = no retry loop).
RETRY_MINUTES=0
RETRY_INTERVAL_SECONDS=120
# 1 = after everything else fails, launch VM.Standard.E2.1.Micro (1 GB RAM; last resort, see ADR-0006).
ALLOW_E2_MICRO=0
NAME_PREFIX=chzzk
BOOT_VOLUME_GB=50
