# Production settings for deploy/prod/compose.yaml (README, 공개 배포). On the VM this file is deploy/prod/.env, mode
# 600, created once by vm-bootstrap.sh with fresh random secrets. Never commit the real one.

# The public host name. Caddy gets its Let's Encrypt certificate for it; the backend's PUBLIC_BASE_URL (Toss
# success/fail redirects) becomes https://<PUBLIC_HOST>. Its DNS A record must point at PUBLIC_IP.
PUBLIC_HOST=live.codecodecode333.dev

# Optional: e-mail for the Let's Encrypt account. Leave empty for none.
ACME_EMAIL=

# The VM's public IP, advertised by MediaMTX for WebRTC media (8189 udp+tcp).
PUBLIC_IP=203.0.113.10

# PostgreSQL password (database and user are both "chzzk"). Letters and digits, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Shared secret of MediaMTX's auth callback to the backend. Letters and digits only (it goes in a URL query), e.g.
#   openssl rand -hex 32
MEDIAMTX_AUTH_SECRET=change-me

# Optional: the 데스크톱 앱's origin, the only one given CORS by the backend (방송 reads) and MediaMTX (WHEP).
# DESKTOP_APP_ORIGIN=app://chzzk

# Optional: Toss Payments TEST-mode keys for 후원 (README, 후원). Uncomment both or neither; never leave them empty.
# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...
